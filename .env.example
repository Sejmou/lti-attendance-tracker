# Drizzle
DATABASE_URL=local.db

# Public origin: scheme, host and port WITHOUT any path (c.f. BASE_PATH)
# Generated QR code for attendance scan on the code screen points here, -> must be reachable from attendees' devices
# needs to use HTTPS too, otherwise attendees' phones cannot create their device keys
ORIGIN=""

# Signs organizer sessions, QR codes and setup links
# For production use 32 character secret generated with high entropy
# Generation command (works e.g. on Ubuntu):
# openssl rand -base64 32
SIGNING_SECRET=""

# Optional: the time zone every time is shown and entered in (default Europe/Vienna).
# PUBLIC_TIMEZONE=Europe/Vienna

# Optional: public Google Calendar whose events are synced into the app.
# Google Calendar > Settings > the calendar > Integrate calendar > "Public address in iCal format"
# CALENDAR_ICS_URL="https://calendar.google.com/calendar/ical/<calendar id>/public/basic.ics"

# Only relevant when the app is served under a sub-path of ORIGIN, e.g. "/attendance" (leading slash, no trailing one!).
# CAUTION: already applied at build time!
# BASE_PATH=/attendance

# Config for deployment via compose.yml

# network interface IP to publish the app on (can keep as-is when using Reverse Proxy; bind that to that same IP)
# BIND_IP=127.0.0.1
# the host port to publish the app on
# HOST_PORT=3000
