# Public hostnames, each served over HTTPS by your reverse proxy (not part of
# this stack), which forwards to the ports below and keeps the Host header.
MOODLE_HOST=moodle.example.com
APP_HOST=attendance.example.com

# Where the containers are published on this machine: point the proxy here.
# 127.0.0.1 keeps them off the network; use another interface's IP (e.g. a
# Tailscale one) if the proxy runs elsewhere.
MOODLE_BIND_IP=127.0.0.1
MOODLE_HOST_PORT=8080
APP_BIND_IP=127.0.0.1
APP_HOST_PORT=3000

# Optional: serve the app under a sub-path of APP_HOST (build time; rebuild after changing)
# BASE_PATH=/attendance

# Passwords for Moodle's `admin` and for the test users (organizer, student1-3)
# MOODLE_ADMIN_PASSWORD=Admin-Test-1
# TESTENV_USER_PASSWORD=Moodle-Test-1

# Language of the course, tool and activity names: de or en (Moodle's own UI stays English)
# TESTENV_LOCALE=de

# Moodle release to build, as download.moodle.org's stableNNN (502 = 5.2, what TUWEL runs)
# MOODLE_BRANCH=502
