# Loaded by vite/vitest in test mode, ahead of .env. Committed on purpose:
# nothing here is a real secret and the tests need a database of their own.
DATABASE_URL=.test.db

ORIGIN="http://localhost:5173"
SIGNING_SECRET="test-secret-not-used-outside-the-test-suite"

# Set here so that a zone set in .env for running the app doesn't reach the
# tests, which check times in Vienna.
PUBLIC_TIMEZONE="Europe/Vienna"

# The sync tests count on 30 days back, whatever .env says.
CALENDAR_SYNC_PAST_DAYS=30
